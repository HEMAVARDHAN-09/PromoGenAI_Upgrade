# Copy this file to ".env" (same folder) and edit. Never commit .env.

# Signing key for login tokens. Leave blank to auto-generate a private key file (.secret_key) on first start.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=1440

# --- Script generation (optional). Without LLM_API_KEY the app runs in clearly labelled DEMO mode.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# --- AI voiceover (optional). Without it, the "System voice" option is offered when your OS has one.
TTS_API_KEY=
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_MODEL=tts-1
TTS_VOICE=alloy

MAX_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=80
# Extra origins allowed to call the API (only needed if you open the frontend from another server, e.g. VS Code Live Server)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# --- Speech-to-text for the microphone buttons (optional; OpenAI-compatible /audio/transcriptions endpoint).
# Without STT_API_KEY the microphone buttons show a clear "not configured" message - nothing is faked.
STT_API_KEY=
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1
MAX_AUDIO_MB=25

# Optional: comma-separated list of voices your TTS provider offers (shown in the voice picker). Default: TTS_VOICE only.
# OpenAI example: TTS_VOICES=alloy,echo,fable,onyx,nova,shimmer
TTS_VOICES=
